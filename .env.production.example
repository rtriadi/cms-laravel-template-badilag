# Contoh konfigurasi PRODUKSI SatkerCMS.
# Salin menjadi `.env` di peladen, lalu isi semua nilai placeholder.
# Jalankan `php artisan key:generate` setelah APP_KEY dibiarkan kosong.

APP_NAME="SatkerCMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pa-contoh.go.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Makassar
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=satker_cms
DB_USERNAME=satker_cms
DB_PASSWORD=GANTI_SANDI_DATABASE

ADMIN_PATH=panel-admin

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Wajib diisi agar backup otomatis harian menghasilkan arsip terenkripsi.
BACKUP_ARCHIVE_PASSWORD=GANTI_SANDI_ARSIP_BACKUP

# Opsional: isi agar notifikasi backup sukses/gagal dikirim ke surel operator.
BACKUP_NOTIFICATION_EMAIL=

# Opsional: isi hanya jika perintah mysqldump berada di direktori non-standar.
# MYSQL_DUMP_BINARY_PATH=/usr/bin

# Deteksi pembaruan GitHub & Zero-Downtime Updater (opsional)
# CMS_UPDATE_ENABLED=true
# CMS_UPDATE_REPO=rtriadi/cms-laravel-template-badilag
# CMS_UPDATE_CHANNEL=stable
# CMS_PUBLIC_PATH=

# Gunakan SMTP nyata di produksi; `log` membuat surel tidak pernah terkirim.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.contoh.go.id
MAIL_PORT=587
MAIL_USERNAME=noreply@pa-contoh.go.id
MAIL_PASSWORD=GANTI_SANDI_SMTP
MAIL_FROM_ADDRESS="noreply@pa-contoh.go.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
